{
  "name": "mt-cost",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "prototype": "EXPO_PUBLIC_UI_PROTOTYPE=1 expo start",
    "prototype:web": "python3 -m http.server 8765 --directory src/ui/prototype",
    "android": "expo run:android",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:android": "npx eas-cli build --platform android --profile production",
    "submit:android": "npx eas-cli submit --platform android --profile production",
    "play-release": "bash scripts/play-release.sh"
  },
  "dependencies": {
    "expo": "~57.0.18",
    "expo-constants": "~57.0.16",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2",
    "vitest": "^4.1.11"
  }
}
