# WG Public API application_id from Wargaming Developer Room → My applications.
# One id for all three realms (NA/EU/ASIA). Do not commit the real value.
WG_APPLICATION_ID=

# Local path to the Play Console service account JSON (gitignored).
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json

# Rate snapshots for Оценка. Not a live shop. Revise by hand.
# Курс серебра: 1 gold → 400 silver (valuation uses the reverse).
WG_SILVER_PER_GOLD=400
# Курс бон: 1 bond → 1.6 gold. Not an official exchange.
WG_GOLD_PER_BOND=1.6
# Свободный опыт: 1 gold = 25 XP.
WG_FREE_XP_PER_GOLD=25

# Курс золота: largest gold-only pack, no discount, no bundle.
# EU snapshot 2026-10-01, permanent_gold30500.
WG_EU_GOLD_PACK_GOLD=30500
WG_EU_GOLD_PACK_EUR=99.99
# NA snapshot 2026-10-01, US storefront, title us.wot, permanent_gold25000.
WG_NA_GOLD_PACK_GOLD=25000
WG_NA_GOLD_PACK_USD=99.99
# ASIA snapshot 2026-10-01, CN storefront, title sg.wot, ps_p_51 (25 000 gold).
WG_ASIA_GOLD_PACK_GOLD=25000
WG_ASIA_GOLD_PACK_CNY=625
