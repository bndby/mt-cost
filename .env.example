# Copy to .env and fill from Lesta Dev Room → My applications.
# Do not commit the real value.
LESTA_APPLICATION_ID=

# Local path to the Play Console service account JSON (gitignored).
# Produced by scripts/play-release.sh.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json

# Rate snapshots for Оценка. Not a live shop, not the glossary. Revise by hand.
# Курс серебра: official in-game 1 gold → 400 silver (valuation uses the reverse).
SILVER_PER_GOLD=400
# Курс золота: largest undiscounted pack, snapshot 2026-08-30.
GOLD_PACK_GOLD=50000
GOLD_PACK_RUBLES=7800
# Курс бон: convention of this Оценка, not a Lesta exchange. 1 bond → 1 gold.
GOLD_PER_BOND=1

# Display currency snapshots. CBR 2026-08-31, not a live feed.
# 1 USD = 85.6007 RUB; 1 BYN = 28.1618 RUB.
RUB_PER_USD=85.6007
RUB_PER_BYN=28.1618

# Rate snapshots for WG-аккаунт (World of Tanks, WG Public API). Same shape as
# the Lesta rates above, one universal set for all three realms (NA/EU/ASIA),
# chain ends in USD (WG sells in dollars, not rubles). Placeholders, not a
# verified snapshot — revise by hand.
WG_SILVER_PER_GOLD=400
WG_GOLD_PACK_GOLD=50000
WG_GOLD_PACK_USD=100
# Курс бон (WG): no official exchange, same as Lesta (confirmed in
# https://github.com/bndby/mt-cost/issues/50). Same convention: 1 bond → 1 gold.
WG_GOLD_PER_BOND=1
